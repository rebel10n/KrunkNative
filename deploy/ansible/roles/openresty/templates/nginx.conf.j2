# {{ ansible_managed }} (deploy/ansible role openresty)
# OpenResty for KrunkNative: the static web build on loopback only. The host's
# nginx keeps :80/:443; cloudflared ingress maps krunker.party -> localhost:8081.
user {{ openresty_worker_user }} {{ openresty_worker_group }};
worker_processes {{ openresty_worker_processes }};
pid logs/nginx.pid;
error_log logs/error.log warn;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    server_tokens off;
    sendfile      on;
    tcp_nopush    on;
    keepalive_timeout 65;
    access_log    off;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml text/plain;
    gzip_min_length 1024;

    # Cloudflare tunnel connects from loopback; trust its client-IP header.
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_header CF-Connecting-IP;

{% if openresty_api_routes %}
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }
{% endif %}

    server {
{% for l in openresty_listen %}
        listen {{ l }};
{% endfor %}
        server_name {{ kn_domain }} _;

        # current -> releases/<id> (role kn_web); assets live outside the releases.
        root {{ openresty_web_root }};
        index index.html;
        disable_symlinks off;

        # Game content (~1.5 GB), shared by every release, fetched on demand.
        location /assets/ {
            alias {{ openresty_assets_dir }}/;
            expires 1h;
            add_header Cache-Control "public" always;
            add_header Access-Control-Allow-Origin "*" always;
        }

        # The page and the wasm loader change with every release.
        location = /index.html { add_header Cache-Control "no-cache" always; }
        location ~ ^/(client\.(js|wasm|data)|js/) {
            add_header Cache-Control "no-cache" always;
        }

{% if openresty_api_routes %}
        location ~ ^/(auth|mm|api|social)/ {
            proxy_pass http://{{ openresty_coordinator_upstream }};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_read_timeout 3600s;
            proxy_buffering off;
        }
        location ~ ^/(servers|finder)/ {
            proxy_pass http://{{ openresty_finder_upstream }};
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
        }
{% endif %}

        location = /healthz {
            default_type text/plain;
            return 200 "ok\n";
        }

        location / {
            try_files $uri $uri/ =404;
        }
    }
}
