{
  "_comment": "{{ ansible_managed }}. Lives in the release (releases/<id>/config/config.json) so kn_config's root = the release and relative defaults (assets/, services/db/migrations/<dialect>) resolve inside it. No secrets here: they come from {{ kn_etc_dir }}/secrets.env.",
  "log": { "level": "{{ kn_brain_log_level }}", "format": "text", "file": "" },
  "brain": {
    "host": "127.0.0.1",
    "trust_proxy": true,
    "region": "us",
    "federation": false,
    "cors_origins": {{ (kn_web_origins + ["https://coordinator." ~ kn_domain, "https://matchmaker." ~ kn_domain]) | to_json }}
  },
  "accounts": {
    "developers": {{ kn_brain_developers | to_json }},
    "moderators": {{ kn_brain_moderators | to_json }},
    "current_season": {{ kn_brain_current_season | int }},
    "store_season": {{ kn_brain_store_season | default(kn_brain_current_season) | int }},
    "_comment_store_season": "config.currentSeason of the store table / prize wheels (accounts.store_season, services/brain/store.c): the season their unseasoned items roll. 10 for Krunker v10.0.2.",
    "email": { "require_verified": {{ kn_brain_email_require_verified | to_json }} }
  },
  "user_assets": {
    "_comment": "GET /api/user-assets/<id>/<file> (services/brain/user_assets.c): the clients' mirror of Krunker's user-asset host for community maps. The cache lives in the state dir (the release is read-only and replaced). Its proxy: KN_USER_ASSETS_PROXY in {{ kn_etc_dir }}/user-assets.env, written from the krunkbox .env's PROXY (tasks/user_assets_proxy.yml).",
    "cache_dir": "{{ kn_state_dir }}/user-assets"
  },
  "ai": {
    "_comment": "The map editor's AI (services/brain/ai.h). The upstream URL + key: {{ kn_etc_dir }}/ai.env. Web search: role kn_ai_search.",
    "search": { "command": {{ (kn_ai_search_command | default('')) | to_json }} }
  }
}
