# Host aliases for deploy/ansible (ansible.cfg passes -F ssh_config).
# CI overrides kru with KRU_HOST/KRU_PORT (inventory/hosts.yml) and its own key, divide with
# DIVIDE_SSH_KEY and the edges with EDGES_SSH_KEY (.github/workflows/deploy-*.yml).

# divide: the Proxmox host of kru (CT 120) and kn-mnz (CT 203) since 2026-11-16. Its only public
# address; the guests are on its NAT bridge vmbr1 (172.16.5.0/24) and every connection to them
# jumps through here (-o ProxyJump=divide from inventory group divide, kn_ssh_jump). ssh passes
# this file (-F) on to the jump, so this block applies there too.
Host divide
  HostName 91.199.82.174
  User root
  IdentityFile ~/.ssh/desktop_ed25519

# Central node: Debian 12 LXC (CT 120 on divide), root. Only a LAN address (no public one of its
# own since meal; 91.199.82.174 on its lo is for kn-rtc ICE only): reached through divide.
Host kru
  HostName 172.16.5.47
  User root

# --- Edges, new: dedicated KrunkNative VMs on the wisp Proxmox hosts (inventory group edges_kn).
# KrunkNative is the only tenant and owns the firewall + fail2ban base. HostName: the VM's address
# (kn_public_ip in inventory/hosts.yml; built 2026-11-12 by abulxt's pve_edge_vm, VM 110).
# None is left: kn-mia (Miami), kn-iev (Kyiv) and kn-jnb (Johannesburg) went on 2026-11-19 (their servers
# moved to kn-mnz on divide), kn-ams (Amsterdam) on 2026-11-23.
# Ashburn/Manassas, US: CT 203 "kn" on divide (VM 123 on meal until 2026-11-16). LAN address only,
# reached through divide (inventory group divide).
Host kn-mnz
  HostName 172.16.5.94
  User root
  # CT 203 trusts divide's admin keys (divide.desktop), not the id_ed25519 of the wisp kn VMs
  IdentityFile ~/.ssh/desktop_ed25519
