# Host aliases for deploy/ansible (ansible.cfg passes -F ssh_config).
# CI overrides kru with KRU_HOST/KRU_PORT (inventory/hosts.yml) and its own key.

# Central node: Debian 12 LXC, root. 172.16.5.47 is the LAN address; the public one
# is 5.188.124.56 (GitHub-hosted runners must use that).
Host kru
  HostName 172.16.5.47
  User root

# --- Edges, new: dedicated KrunkNative VMs on the wisp Proxmox hosts (inventory group edges_kn).
# KrunkNative is the only tenant and owns the firewall + fail2ban base. HostName: the VM's address
# (kn_public_ip in inventory/hosts.yml; built 2026-11-12 by abulxt's pve_edge_vm, VM 110).
# Miami, US
Host kn-mia
  HostName 45.92.71.48
  User root
  # abulxt's pve_edge_vm installs the controller's id_ed25519.pub on the kn VMs
  IdentityFile ~/.ssh/id_ed25519

# Kyiv, UA
Host kn-iev
  HostName 185.101.138.155
  User root
  # abulxt's pve_edge_vm installs the controller's id_ed25519.pub on the kn VMs
  IdentityFile ~/.ssh/id_ed25519
