#!/usr/bin/env python3
"""kn-network: run a KrunkNative server network (coordinators + dedicated servers) from one file.

  services/scripts/kn-network [up] [NETWORK.json]   start everything in the foreground; Ctrl+C drains and stops
  services/scripts/kn-network status [NETWORK.json] query every server (server-info query) + coordinator /mm/status

NETWORK.json (default services/scripts/network.example.json) lists coordinators (kn_brain, one
port each, all on config/config.json's database = one federated network, doc/backend.md 6)
and server groups (`count` server_bin processes each, ports port, port+1, ...). Each server
gets a generated server.cfg in log_dir; every key of a server group other than count /
coordinator / port is written into it, so any server.cfg / gameserver key works.
Run from the repository root.
"""
import json
import os
import signal
import socket
import subprocess
import sys
import time
import urllib.request

ROOT = os.getcwd()
GROUP_KEYS = {"count", "coordinator", "port"}


def load(path):
    with open(path) as f:
        net = json.load(f)
    net.setdefault("build_dir", "cmake-build-debug")
    net.setdefault("log_dir", "/tmp/kn-network")
    net.setdefault("migrate", True)
    coords = {c["name"]: c for c in net.get("coordinators", [])}
    servers = []
    for g in net.get("servers", []):
        coord = coords.get(g.get("coordinator")) if g.get("coordinator") else None
        if g.get("coordinator") and not coord:
            sys.exit(f"kn-network: server group refers to unknown coordinator {g['coordinator']!r}")
        for i in range(int(g.get("count", 1))):
            cfg = {k: v for k, v in g.items() if k not in GROUP_KEYS}
            port = int(g.get("port", 21015)) + i
            cfg["port"] = port
            node = str(g.get("node_id", "N"))
            cfg["node_id"] = f"{node}{i}" if int(g.get("count", 1)) > 1 else node
            if int(g.get("count", 1)) > 1 and "hostname" in g:
                cfg["hostname"] = f"{g['hostname']} #{i + 1}"
            if coord:
                cfg.setdefault("coordinator_url", f"ws://127.0.0.1:{coord['port']}/mm/internal/ws")
                cfg.setdefault("coordinator_http_url", f"http://127.0.0.1:{coord['port']}")
                if coord.get("community"):
                    cfg.setdefault("community", coord["community"])
            servers.append({"name": cfg["node_id"], "port": port, "cfg": cfg, "coord": coord})
    return net, list(coords.values()), servers


def cfg_value(v):
    if isinstance(v, bool):
        return "1" if v else "0"
    if isinstance(v, list):
        return ",".join(str(x) for x in v)
    if isinstance(v, (dict,)):
        return json.dumps(v)
    s = str(v)
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def write_cfg(path, cfg):
    with open(path, "w") as f:
        f.write("// generated by services/scripts/kn-network\n")
        for k, v in cfg.items():
            if isinstance(v, dict) and k == "game":
                for gk, gv in v.items():
                    f.write(f"game.{gk} {cfg_value(gv)}\n")
            else:
                f.write(f"{k} {cfg_value(v)}\n")


def wait_port(port, timeout=15.0, udp=False):
    end = time.time() + timeout
    while time.time() < end:
        try:
            if udp:
                if query("127.0.0.1", port, 0.3):
                    return True
            else:
                with socket.create_connection(("127.0.0.1", port), 0.3):
                    return True
        except OSError:
            pass
        time.sleep(0.2)
    return False


def query(host, port, timeout=1.0):
    nonce = os.urandom(6).hex()
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.settimeout(timeout)
        s.sendto(b"\xff\xff\xff\xffKNINFO\x00" + nonce.encode(), (host, port))
        data, _ = s.recvfrom(2048)
    if not data.startswith(b"\xff\xff\xff\xffKNinfo\x00"):
        return None
    info = json.loads(data[11:])
    return info if info.get("nonce") == nonce else None


def up(net, coords, servers):
    build, logs = net["build_dir"], net["log_dir"]
    os.makedirs(logs, exist_ok=True)
    brain = os.path.join(build, "services/brain/kn_brain")
    server_bin = os.path.join(build, "server_bin")
    procs = []

    def stop(*_):
        # servers first (they drain + commit stats through their coordinator), then coordinators
        for kind in ("server", "coordinator"):
            group = [p for k, _, p in procs if k == kind and p.poll() is None]
            for p in group:
                p.send_signal(signal.SIGTERM)
            for p in group:
                try:
                    p.wait(20)
                except subprocess.TimeoutExpired:
                    p.kill()
        sys.exit(0)

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    if net.get("migrate") and coords:
        migrate = os.path.join(build, "services/common/kn_migrate")
        print("[kn-network] migrating the database")
        subprocess.run([migrate] + net.get("args", []), check=True)
    for c in coords:
        log = open(os.path.join(logs, f"coord-{c['name']}.log"), "w")
        args = [brain, "--set", f"brain.port={c['port']}", "--set", f"brain.region={c.get('region', 'local')}",
                "--set", f"brain.id={c.get('id', 'coord-' + c['name'])}"]
        if c.get("community"):
            args += ["--set", f"brain.community={c['community']}"]
        args += c.get("args", []) + net.get("args", [])
        procs.append(("coordinator", c["name"], subprocess.Popen(args, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)))
        print(f"[kn-network] coordinator {c['name']} on :{c['port']} -> {log.name}")
    for c in coords:
        if not wait_port(c["port"]):
            print(f"[kn-network] coordinator {c['name']} did not come up, see its log")
            stop()
    for s in servers:
        cfg_path = os.path.join(logs, f"{s['name']}.cfg")
        s["cfg"].setdefault("log_file", os.path.join(logs, f"{s['name']}.log"))
        write_cfg(cfg_path, s["cfg"])
        out = open(os.path.join(logs, f"{s['name']}.out"), "w")
        args = [server_bin, "--headless", "--cfg", cfg_path] + net.get("server_args", [])
        procs.append(("server", s["name"], subprocess.Popen(args, stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)))
        print(f"[kn-network] server {s['name']} on :{s['port']} ({s['coord']['name'] if s['coord'] else 'standalone'}) -> {out.name}")
    for s in servers:
        if not wait_port(s["port"], udp=True):
            print(f"[kn-network] server {s['name']} does not answer queries yet, see {logs}/{s['name']}.out")
    print(f"[kn-network] up: {len(coords)} coordinator(s), {len(servers)} server(s); Ctrl+C drains and stops")
    while True:
        for kind, name, p in procs:
            if p.poll() is not None:
                print(f"[kn-network] {kind} {name} exited ({p.returncode}); stopping the network")
                stop()
        time.sleep(1)


def status(net, coords, servers):
    rc = 0
    for c in coords:
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{c['port']}/mm/status", timeout=2) as r:
                body = json.loads(r.read())
            print(f"coordinator {c['name']:<6} :{c['port']}  {json.dumps(body)[:160]}")
        except OSError as e:
            print(f"coordinator {c['name']:<6} :{c['port']}  DOWN ({e})")
            rc = 1
    for s in servers:
        try:
            info = query("127.0.0.1", s["port"])
        except OSError:
            info = None
        if not info:
            print(f"server {s['name']:<8} :{s['port']}  DOWN")
            rc = 1
            continue
        print(f"server {s['name']:<8} :{s['port']}  {info['name']!r} {info['map']}/{info['mode']} "
              f"{info['players']}/{info['max']} [{','.join(info['tags'])}] community={info['community']!r}")
    return rc


def main():
    args = sys.argv[1:]
    cmd = args.pop(0) if args and args[0] in ("up", "status") else "up"
    if args and args[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    path = args[0] if args else os.path.join(ROOT, "services/scripts/network.example.json")
    net, coords, servers = load(path)
    return status(net, coords, servers) if cmd == "status" else up(net, coords, servers)


if __name__ == "__main__":
    sys.exit(main())
