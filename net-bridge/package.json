{
  "name": "net-bridge",
  "version": "1.0.0",
  "scripts": {
    "start": "node -r ts-node/register/transpile-only index.ts",
    "server": "node -r ts-node/register/transpile-only index.ts",
    "native-to-krunker": "node -r ts-node/register/transpile-only index.ts --native-to-krunker",
    "browser-to-native": "node -r ts-node/register/transpile-only index.ts --browser-to-native",
    "web": "node -r ts-node/register/transpile-only index.ts --web",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register/transpile-only webBridge.test.ts && node -r ts-node/register/transpile-only krunkerRelay.test.ts && node -r ts-node/register/transpile-only v10Proxy.test.ts",
    "bridge-only": "node -r ts-node/register/transpile-only index.ts --bridge-only",
    "bundle": "esbuild index.ts --bundle --platform=node --target=node22 --format=cjs --legal-comments=none --external:bufferutil --external:utf-8-validate --outfile=../dist/deploy/net-bridge/net-bridge.js"
  },
  "dependencies": {
    "msgpack-lite": "^0.1.26",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^14.18.63",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2"
  }
}
