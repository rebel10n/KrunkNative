static num sx = 1;
dynamic obj dy = {};

num action fact(num n) {
    if (n <= 1) { return 1; }
    return n * fact(n - 1);
}

str action describe(static num a, dynamic obj b, action cb, num action(num, str) cb2, str action named) {
    cb(a, b);
    return toStr cb2(a, "x") + toStr lengthOf (str) b.name;
}

action noop() {}

action takesArr(num[] a, obj[][] b) {
    addTo a 1;
    addTo b[0] {x: 1};
}

