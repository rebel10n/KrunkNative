# Called from Custom Trigger Action
public action onCustomTrigger(str playerID, str customParam) {
	
	# check parameter
	if (customParam == "1") {
		GAME.log("First Trigger");
	}

	# check parameter
	if (customParam == "2") {
		GAME.log("Second Trigger");
	}
	
}

