# Loops, break/continue, for-each over objects/arrays/strings, actions, recursion, return defaults
num calls = 0;
num action fib(num n) {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}
num action noReturn(num x) {
    if (x > 0) { return x; }
}
str action greet(str who) { return "hi " + who; }
action count() { calls += 1; }
public action start() {
    num total = 0;
    for (num i = 0; i < 10; i++) {
        if (i == 3) { continue; }
        if (i == 8) { break; }
        total += i;
    }
    GAME.log(total);
    num j = 0;
    num k = 0;
    while (j < 5) {
        j++;
        for (num m = 0; m < 3; m++) {
            if (m == j) { break; }
            k += 1;
        }
    }
    GAME.log(j, k);
    obj o = {a: 1, b: "two", c: num[3]};
    for (obj e : o) { GAME.log(e.key, e.value); }
    remove o.a;
    o.a = 9;
    o.d = true;
    str keys = "";
    for (obj e : o) { keys += e.key; }
    GAME.log(keys);
    for (obj e : num[10, 20]) { GAME.log(e.key, e.value); }
    for (obj e : "hi") { GAME.log(e.key + "=" + (str) e.value); }
    num n = 0;
    for (obj e : o) { n++; if (n == 2) { break; } }
    GAME.log(n, fib(15), noReturn(0), noReturn(4), greet("bob"));
    count(); count();
    GAME.log(calls);
    for (num a = 0; a < 3; a++) { num inner = a * 2; GAME.log(inner); }
    num x = 1;
    { num y = 2; x += y; }
    GAME.log(x);
}
