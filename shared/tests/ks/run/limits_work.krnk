# Native work stays bounded (server safety): DAG-shaped data in casts and GAME.log,
# sequential UTF-16 indexing of long non-ASCII strings, substring search on adversarial input
#! call dagCast
#! call dagLog
#! call unicode
#! call search
public action dagCast() {
    obj box = {v: num[1]};
    for (num i = 0; i < 40; i++) {
        num[][] level = num[][];
        num[] prev = (num[]) box.v;
        addTo level prev;
        addTo level prev;
        box.v = level;
    }
    GAME.log("unreachable");
}
public action dagLog() {
    obj node = {leaf: 1};
    for (num i = 0; i < 40; i++) { node = {a: node, b: node}; }
    GAME.log("built");
    GAME.log(node);
}
public action unicode() {
    str s = "é";
    for (num i = 0; i < 17; i++) { s = s + s; }
    num count = 0;
    for (num i = 0; i < lengthOf s; i++) {
        if (s[i] == "é") { count++; }
    }
    GAME.log(lengthOf s, count, UTILS.truncateTxt(s, 2, true));
}
public action search() {
    str a = "a";
    for (num i = 0; i < 19; i++) { a = a + a; }
    str b = UTILS.truncateTxt(a, 262144, true) + "b";
    GAME.log(lengthOf a, lengthOf b, UTILS.textContains(a, b), UTILS.textContains(a + b, b), lengthOf UTILS.replaceText(a + "b", b, "!"));
}
