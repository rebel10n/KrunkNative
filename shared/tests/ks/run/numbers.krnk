# Number::toString, parseFloat casts, arithmetic and bitwise operators (spec 1.6, 1.12, 1.13)
public action start() {
    GAME.log(toStr (0.1 + 0.2), toStr (1 / 3), toStr 1e21, toStr 1e-7, toStr 1e-6);
    GAME.log(toStr (0 * -1), toStr (0 / 0), toStr (2 ** 53), toStr 0xFF, toStr 123456789012345680000);
    GAME.log(toStr (1 / 0), toStr (-1 / 0), 0 * -1, 1.5e300 * 1e10, -1e-320, 5e-324);
    GAME.log((num) "12abc", (num) true, (num) "0x10", (num) "", (num) "  -3.5e2xyz", (num) "Infinity");
    GAME.log(toNum "7.25", toNum "abc", toNum ".5", (num) "1e", (num) "-.5e-1");
    GAME.log(5 % 3, -5 % 3, 5.5 % 2, 5 % 0, -0.5 % 1);
    GAME.log(2 ** 10, 2 ** -1, (-8) ** (1 / 3), 2 ** 3 ** 2, (num) "2" ** 2);
    GAME.log(7 & 3, 7 | 8, 7 ^ 2, ~5, 1 << 31, -16 >> 2, -16 >>> 28, 1 << 32, 4294967296 | 0, 2.7 | 0, -2.7 | 0);
    GAME.log(0.1 * 3, 100 / 3, 1e21 + 1, 0.000001234, 1.5e-7, 123e18, 1e100);
    GAME.log(-(5), +3, -(0 - 0), 10 - 2 - 3, 2 * 3 + 4 * 5, (2 + 3) * 4, 7 / 2);
}
