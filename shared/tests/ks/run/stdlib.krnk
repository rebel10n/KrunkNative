# GAME.UTILS / UTILS.math / TIME.getReadable against the v7 implementations (3.1.5, 3.1.7)
# (transcendental results are rounded where glibc and V8 fdlibm differ in the last ulp)
obj d = {s: "5", t: "abc", none: GAME.PLAYERS.getSelf()};
public action start() {
    GAME.log(Math.sin(1), Math.cos(0), Math.tan(0.5), Math.asin(2), Math.acos(0.5), Math.atan(1), Math.atan2(1, -1));
    GAME.log(Math.sinh(1), Math.cosh(1), Math.tanh(1), Math.asinh(1), Math.acosh(0.5), Math.roundDecimal(Math.atanh(0.5), 12));
    GAME.log(Math.log(0), Math.log(-1), Math.exp(1), Math.sqrt(2), Math.sqrt(-1), Math.abs(-0), Math.abs(-3.5));
    GAME.log(Math.round(2.5), Math.round(-2.5), Math.round(0.49999999999999994), Math.round(-0.4), Math.floor(-1.5), Math.ceil(1.2), Math.trunc(-1.7));
    GAME.log(Math.min(), Math.max(), Math.min(3, 1, 2), Math.max(3, d.t), Math.hypot(3, 4), Math.hypot(), Math.pow(2, 0.5), Math.pow(1, 1 / 0));
    GAME.log(Math.lerp(0, 10, 0.25), Math.lerp(d.s, 10, 0.5), Math.toRad(180), Math.toDeg(Math.PI), Math.calcPerc(200, 15));
    GAME.log(Math.roundToNearest(7, 5), Math.roundToNearest(-7, 5), Math.roundToNearest(0, 5), Math.roundToNearest(d.s, 5), Math.roundToNearest(7, 0));
    GAME.log(Math.roundDecimal(1.236, 2), Math.roundDecimal(1.5), Math.roundDecimal(d.s, 2), Math.roundDecimal(1234.5, -2), Math.E, Math.PI);
    GAME.log(UTILS.getDist2D(0, 0, 3, 4), UTILS.getDist3D(1, 2, 3, 4, 6, 3), Math.roundDecimal(UTILS.anglDst(0, Math.PI * 1.5), 12), UTILS.getDir2D(10, 10, 0, 0));
    obj dir = UTILS.getDir3D(0, 0, 0, 1, 1, 1);
    GAME.log(dir.x, dir.y, UTILS.getDir3D(0, 0, 0, 1, d.s, 1));
    GAME.log(UTILS.hexFromHue(0), UTILS.hexFromHue(120), UTILS.hexFromHue(210), UTILS.hexFromHue(359), UTILS.hexFromHue(-30), UTILS.hexFromHue(d.t));
    GAME.log(UTILS.invertHex("#ff0000"), UTILS.invertHex("00ff00"), UTILS.invertHex("zz"), UTILS.invertHex(""));
    GAME.log(UTILS.RGBtoHEX(255, 128, 0), UTILS.RGBtoHEX(1, 2, 3), UTILS.RGBtoHEX(d.s, 300, -1), UTILS.RGBtoHEX(12.7, 0, 0));
    GAME.log(UTILS.HEXtoRGB("#abc"), UTILS.HEXtoRGB("#102030"), UTILS.HEXtoRGB("red"));
    GAME.log(GAME.TIME.getReadable(61000), GAME.TIME.getReadable(0), GAME.TIME.getReadable(90061000), GAME.TIME.getReadable(400 * 86400000 + 3600000), GAME.TIME.getReadable(d.t));
    num ok = 0;
    for (num i = 0; i < 200; i++) {
        num r = UTILS.randInt(3, 6);
        num f = UTILS.randFloat(-1, 1);
        if (r >= 3 && r <= 6 && Math.floor(r) == r && f >= -1 && f < 1) { ok++; }
    }
    GAME.log("random ok", ok);
}
