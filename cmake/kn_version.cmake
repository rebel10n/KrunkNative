# Writes kn_version.h, the build identity of every KrunkNative binary (shared/include/build_info.h,
# shared/src/build_info.c is its only reader). Run with `cmake -P` at configure time and again at
# every build (custom target kn_version in CMakeLists.txt); the file is rewritten only when its
# content changes, so a no-op build recompiles nothing.
#
#   -DKN_SRC_DIR=<repo> -DKN_OUT=<.../generated/kn_version.h>
#   -DKN_OVR_DESCRIBE= -DKN_OVR_COMMIT= -DKN_OVR_COMMIT_TIME= -DKN_OVR_BUILD_TIME=
#     (the KRUNKNATIVE_VERSION_* cache variables: CI builds in containers without git pass them;
#      a non-empty override wins over git)
#
# KN_VERSION_DESCRIBE  git describe --tags --match 'server-v*' --match 'v[0-9]*' --exclude '*-parity*'
#                      --always --dirty ("v1.0.0-51-g6f0cea9", "6f0cea9-dirty"), "unknown" without git
# KN_VERSION_COMMIT    12-hex commit ("" unknown); KN_VERSION_COMMIT_TIME its committer date (unix s, 0)
# KN_VERSION_DIRTY     1 when the tree had local changes
# KN_VERSION_LOCAL     1 for a local build, one the updates server never published: a dirty tree, no
#                      commit, or a commit origin/main does not have (git merge-base --is-ancestor). 0 when
#                      the commit is published or cannot be checked (no origin/main here, a CI override):
#                      the client's update box and Outdated check stay on for those (update_ui.c)
# KN_VERSION_BUILD_TIME ISO-8601 UTC time this identity was first built (SOURCE_DATE_EPOCH honoured)
cmake_minimum_required(VERSION 3.10)

set(describe "${KN_OVR_DESCRIBE}")
set(commit "${KN_OVR_COMMIT}")
set(commit_from_override "${KN_OVR_COMMIT}")
set(commit_time "${KN_OVR_COMMIT_TIME}")
set(dirty 0)

find_program(KN_GIT git)
if (KN_GIT AND EXISTS "${KN_SRC_DIR}/.git")
    if (describe STREQUAL "")
        execute_process(COMMAND "${KN_GIT}" -C "${KN_SRC_DIR}" describe --tags --match "server-v*" --match "v[0-9]*"
                                --exclude "*-parity*" --always --dirty --abbrev=7
                        OUTPUT_VARIABLE describe OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if (NOT rc EQUAL 0)
            set(describe "")
        endif ()
    endif ()
    if (commit STREQUAL "")
        execute_process(COMMAND "${KN_GIT}" -C "${KN_SRC_DIR}" rev-parse --short=12 HEAD
                        OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if (NOT rc EQUAL 0)
            set(commit "")
        endif ()
    endif ()
    if (commit_time STREQUAL "")
        execute_process(COMMAND "${KN_GIT}" -C "${KN_SRC_DIR}" log -1 --format=%ct HEAD
                        OUTPUT_VARIABLE commit_time OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
        if (NOT rc EQUAL 0)
            set(commit_time "")
        endif ()
    endif ()
endif ()

string(LENGTH "${commit}" commit_len)
if (commit_len GREATER 12)
    string(SUBSTRING "${commit}" 0 12 commit)
endif ()
if (NOT commit MATCHES "^[0-9a-fA-F]*$")
    set(commit "")
endif ()
string(TOLOWER "${commit}" commit)
if (NOT commit_time MATCHES "^[0-9]+$")
    set(commit_time 0)
endif ()
if (describe STREQUAL "")
    if (NOT commit STREQUAL "")
        set(describe "${commit}")
    else ()
        set(describe "unknown")
    endif ()
endif ()
if (describe MATCHES "-dirty$")
    set(dirty 1)
endif ()
set(local 0)
if (dirty OR commit STREQUAL "")
    set(local 1)
elseif (commit_from_override STREQUAL "" AND KN_GIT AND EXISTS "${KN_SRC_DIR}/.git")
    # exit 1: not an ancestor of origin/main (a branch, an unpushed commit); 128 (no origin/main here): unknown
    execute_process(COMMAND "${KN_GIT}" -C "${KN_SRC_DIR}" merge-base --is-ancestor HEAD origin/main
                    OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE rc)
    if (rc EQUAL 1)
        set(local 1)
    endif ()
endif ()
# C string literal safety (describe comes from tag names or a CI variable)
string(REGEX REPLACE "[^A-Za-z0-9._+-]" "_" describe "${describe}")

set(identity "${describe}|${commit}|${commit_time}|${dirty}|${local}")
set(build_time "${KN_OVR_BUILD_TIME}")
if (build_time STREQUAL "" AND EXISTS "${KN_OUT}")
    # same identity as the last build: keep its time (the header, and every binary, stay as they are)
    file(STRINGS "${KN_OUT}" old_identity REGEX "^// identity: ")
    file(STRINGS "${KN_OUT}" old_time REGEX "^#define KN_VERSION_BUILD_TIME ")
    if (old_identity STREQUAL "// identity: ${identity}" AND old_time MATCHES "\"([0-9TZ:-]+)\"")
        set(build_time "${CMAKE_MATCH_1}")
    endif ()
endif ()
if (build_time STREQUAL "")
    string(TIMESTAMP build_time "%Y-%m-%dT%H:%M:%SZ" UTC)
endif ()
if (NOT build_time MATCHES "^[0-9TZ:-]+$")
    set(build_time "1970-01-01T00:00:00Z")
endif ()

set(content "// Generated by cmake/kn_version.cmake: do not edit.\n// identity: ${identity}\n#pragma once\n#define KN_VERSION_DESCRIBE \"${describe}\"\n#define KN_VERSION_COMMIT \"${commit}\"\n#define KN_VERSION_COMMIT_TIME ${commit_time}LL\n#define KN_VERSION_DIRTY ${dirty}\n#define KN_VERSION_LOCAL ${local}\n#define KN_VERSION_BUILD_TIME \"${build_time}\"\n")
set(old "")
if (EXISTS "${KN_OUT}")
    file(READ "${KN_OUT}" old)
endif ()
if (NOT old STREQUAL content)
    file(WRITE "${KN_OUT}" "${content}")
endif ()
