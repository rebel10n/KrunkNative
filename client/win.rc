// Windows resources of client.exe and the launcher (BoxOffice.exe): the icon (krunker.io's
// app icon, tools/branding/fetch_branding.py) and the version information Explorer and Task
// Manager show ("Krunker Box Office"; the file names keep the project's old name, KrunkNative).
// No version numbers here: the build identity is `--version` (shared/include/build_info.h).
#include <winver.h>

IDI_ICON1 ICON DISCARDABLE "icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Krunker Box Office"
            VALUE "ProductName", "Krunker Box Office"
            VALUE "InternalName", "KrunkNative"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
